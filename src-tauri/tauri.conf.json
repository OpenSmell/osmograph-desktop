{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Osmograph",
  "version": "0.1.2-beta.2",
  "identifier": "com.opensmell.osmograph-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Osmograph — the software for smell",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "decorations": true,
        "maximized": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzZGQkQ3QjAwRUExNDYKUldSR29RNncxL3ZHYlJncWxQeHpDYWJLSGo2bi9EZFhEUE9JK3lRc0IrQXdNU08rek1uWFlGWm0K",
      "endpoints": [
        "https://github.com/OpenSmell/osmograph-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
